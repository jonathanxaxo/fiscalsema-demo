# Exemplo sem credenciais. Configure os valores reais somente na Vercel.
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=core.settings_demo
APP_ENVIRONMENT=demo
DATABASE_URL=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=5
DJANGO_LOG_LEVEL=INFO
DJANGO_FILE_LOGGING=False
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900
API_RATE_LIMIT_PER_MINUTE=60
API_DEFAULT_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=Administrador Demonstração
# Assistente IA (Sprint 21). ASSISTANT_API_KEY é SECRETA: preencha só na Vercel.
ASSISTANT_ENABLED=False
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ASSISTANT_MODELS=
ASSISTANT_TIMEOUT_SECONDS=12
ASSISTANT_DAILY_LIMIT=60
ASSISTANT_PER_MINUTE=6
ASSISTANT_RETENTION_DAYS=30
# Login com Google (Sprint 25). GOOGLE_OAUTH_CLIENT_SECRET é SECRETO: só na Vercel.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TIMEOUT_SECONDS=10
# E-mail SMTP (Sprint 26). EMAIL_HOST_PASSWORD é SECRETA (senha de app): só na Vercel.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Cadastro institucional (Sprint 27). Domínios inteiros e exceções exatas, separados por vírgula.
ALLOWED_SIGNUP_DOMAINS=
ALLOWED_SIGNUP_EMAILS=
GOOGLE_REQUIRE_HOSTED_DOMAIN=False
